<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ollama is usually served over plain HTTP on localhost or the local network. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- English fallback; translations live in InfoPlist.xcstrings. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to the language model server on your local network.</string>
</dict>
</plist>
